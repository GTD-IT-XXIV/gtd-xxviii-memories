# Neon Postgres connection string. The `photos` / `clusters` / `faces` schema
# is created and owned by the separate Python pipeline, not by this app.
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible object storage). Bucket is private; this app
# generates short-lived presigned GET URLs server-side for every image shown.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# --- Telegram Login, OpenID Connect (gates the whole app -- see README.md
# "Authentication") ---

# From @BotFather: Bot Settings > Web Login. Register this app's exact
# deployed callback URL there (https://<domain>/api/auth/telegram/callback)
# -- see README.md.
TELEGRAM_OIDC_CLIENT_ID=your_bot_client_id

# Secret from the same BotFather screen. Server-side only, used in the
# token-endpoint exchange. Never expose to the client.
TELEGRAM_OIDC_CLIENT_SECRET=your_bot_client_secret

# Secret used to sign session JWTs (via `jose`). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand--base64-32
