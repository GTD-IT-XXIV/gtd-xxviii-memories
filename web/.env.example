# Neon Postgres connection string. The `photos` / `clusters` / `faces` schema
# is created and owned by the separate Python pipeline, not by this app.
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible object storage). Bucket is private; this app
# generates short-lived presigned GET URLs server-side for every image shown.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# --- Telegram Login (gates the whole app -- see README.md "Authentication") ---

# @username of the Telegram bot used for the Login Widget (no leading @).
# You must create this bot yourself via @BotFather and register this app's
# deployed domain against it with /setdomain -- see README.md.
TELEGRAM_BOT_USERNAME=your_bot_username

# Secret bot token from @BotFather. Server-side only, used to verify that
# login callbacks really came from Telegram. Never expose to the client.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Secret used to sign session JWTs (via `jose`). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand--base64-32
